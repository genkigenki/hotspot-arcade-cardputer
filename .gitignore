# arduino-cli output. build*/ not build/: other targets land in build-lilygo/ and
# build-headless/, and those are artefacts too.
build*/

# M5Burner package (generated from build/ by tools/package-m5burner.sh)
firmware/

# generated into the sketch folder by tools/gen-assets.mjs -- regenerate, don't commit
hotspot-arcade-cardputer/ha_bundle.h
hotspot-arcade-cardputer/ha_proto.h
hotspot-arcade-cardputer/ha_json.h
hotspot-arcade-cardputer/ha_games.h

# OS
.DS_Store
Thumbs.db

# junk from a crashed tool
*.stackdump

# Local working notes, never published
docs/HANDOVER.md
